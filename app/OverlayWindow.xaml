<Window x:Class="ClaudeTaskBar.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="claude-task-bar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Width="340" Height="260">
    <Grid>
        <Grid x:Name="Root" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide" X="360" />
            </Grid.RenderTransform>
            <StackPanel HorizontalAlignment="Right">
                <Border x:Name="Bubble" Background="#faf6ee" BorderBrush="#7a3b28" BorderThickness="2"
                        CornerRadius="12" Padding="10,7" HorizontalAlignment="Right" Margin="0,0,12,6">
                    <StackPanel>
                        <TextBlock x:Name="Chip" Text="Claude" FontSize="11" Foreground="#7a3b28"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="Msg" Text="終わったよー！" FontSize="14" FontWeight="Bold"
                                   Foreground="#2b2320" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Image x:Name="Mascot" Width="161" Height="161" HorizontalAlignment="Right"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
